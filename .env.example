# Local environment variables for ABL Vertex Solutions
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets to Git.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Required at BUILD TIME (injected into the browser bundle by Vite):
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Required at RUNTIME (server-side only, never exposed to the browser):
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Admin Session ───────────────────────────────────────────────────────────
# Any long random string — used to sign the encrypted session cookie.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
